{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doot",
  "version": "0.1.0",
  "identifier": "app.doot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doot",
        "width": 780,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "alwaysOnTop": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost ws://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.svg"],
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
