{
  "name": "@doot/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "tsx --test test/**/*.test.ts",
    "benchmark:live": "tsx scripts/benchmark-live.ts"
  },
  "dependencies": {
    "@doot/protocol": "0.1.0",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
