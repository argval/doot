# Local Turso SQLite file (defaults to packages/db/data/doot.db)
DOOT_DB_PATH=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# Standalone gateway only. Native Doot generates its own local token.
DOOT_GATEWAY_TOKEN=
# Explicit opt-in for the browser preview on 127.0.0.1; never use on a shared host.
DOOT_ALLOW_UNAUTHENTICATED=1
# English/Indic STT and Indic text translation
SARVAM_API_KEY=
# Gemini Transcribe Live STT, Live Translate baseline, and Gemini text MT
GEMINI_API_KEY=
